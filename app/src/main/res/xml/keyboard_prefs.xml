    <PreferenceScreen
        android:key="pref_group_keys"
        android:title="@string/pref_group_keys_title"
        app:singleLineTitle="false"
        android:summary="@string/pref_group_keys_summary">
        <SwitchPreferenceCompat
            android:key="pref_number_row"
            android:title="@string/pref_number_row_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_number_row_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
