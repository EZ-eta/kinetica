            android:summary="@string/pref_long_press_summary"
            app:singleLineTitle="false"
            android:defaultValue="500"
            app:sliderSteps="@array/timing_steps_long_press" />
        <SwitchPreferenceCompat
            android:key="pref_typing_speed"
            android:title="@string/pref_typing_speed_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_typing_speed_summary"
            android:defaultValue="false" />
        <PreferenceScreen
