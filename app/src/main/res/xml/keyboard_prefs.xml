<?xml version="1.0" encoding="utf-8"?>
<!-- Progressive disclosure: about a dozen rows here, the everyday settings one level
     down, the expert ones a level below that. Nothing deeper. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceScreen
        android:key="pref_group_languages"
        android:title="@string/pref_group_languages_title"
        app:singleLineTitle="false"
        android:summary="@string/pref_group_languages_summary">
        <ListPreference
            android:key="pref_language"
            android:title="@string/pref_language_title"
            app:singleLineTitle="false"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="en"
            app:useSimpleSummaryProvider="true" />
        <MultiSelectListPreference
            android:key="pref_enabled_languages"
            android:title="@string/pref_enabled_languages_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_enabled_languages_summary"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="@array/language_default_values" />
        <SwitchPreferenceCompat
            android:key="pref_sync_system_language"
            android:title="@string/pref_sync_system_language_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_sync_system_language_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="pref_british_spelling"
            android:title="@string/pref_british_spelling_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_british_spelling_summary"
            android:defaultValue="false" />
        <PreferenceScreen
            android:key="pref_group_languages_more"
            android:title="@string/pref_group_languages_more_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_group_languages_more_summary">
            <SwitchPreferenceCompat
                android:key="pref_auto_detect_language"
                android:title="@string/pref_auto_detect_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_auto_detect_summary"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_no_primary"
                android:title="@string/pref_no_primary_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_no_primary_summary"
                android:defaultValue="false" />
        </PreferenceScreen>
    </PreferenceScreen>

    <PreferenceScreen
        android:key="pref_group_typing"
        android:title="@string/pref_group_typing_title"
        app:singleLineTitle="false"
        android:summary="@string/pref_group_typing_summary">
        <ListPreference
            android:key="pref_autocorrect_level"
            android:title="@string/pref_autocorrect_title"
            app:singleLineTitle="false"
            android:entries="@array/autocorrect_entries"
            android:entryValues="@array/autocorrect_values"
            android:defaultValue="normal"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="pref_auto_capitalize"
            android:title="@string/pref_auto_capitalize_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_auto_capitalize_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="pref_next_word"
            android:title="@string/pref_next_word_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_next_word_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="pref_enter_action"
            android:title="@string/pref_enter_action_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_enter_action_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="pref_peck_mode"
            android:title="@string/pref_peck_mode_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_peck_mode_summary"
            android:defaultValue="false" />
        <PreferenceScreen
            android:key="pref_group_spacing"
            android:title="@string/pref_group_spacing_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_group_spacing_summary">
            <SwitchPreferenceCompat
                android:key="pref_autospace"
                android:title="@string/pref_autospace_title"
                app:singleLineTitle="false"
                android:defaultValue="true" />
            <com.kinetica.keyboard.settings.SteppedSliderPreference
                android:key="pref_autospace_delay_ms"
                android:title="@string/pref_autospace_delay_title"
                android:summary="@string/pref_autospace_delay_summary"
                app:singleLineTitle="false"
                android:defaultValue="300"
                app:sliderSteps="@array/timing_steps_autospace"
                android:dependency="pref_autospace" />
            <com.kinetica.keyboard.settings.SteppedSliderPreference
                android:key="pref_autospace_tap_delay_ms"
                android:title="@string/pref_autospace_tap_delay_title"
                android:summary="@string/pref_autospace_tap_delay_summary"
                app:singleLineTitle="false"
                android:defaultValue="300"
                app:sliderSteps="@array/timing_steps_autospace"
                android:dependency="pref_autospace" />
            <com.kinetica.keyboard.settings.SteppedSliderPreference
                android:key="pref_autospace_retract_ms"
                android:title="@string/pref_autospace_retract_title"
                android:summary="@string/pref_autospace_retract_summary"
                app:singleLineTitle="false"
                android:defaultValue="600"
                app:sliderSteps="@array/timing_steps_retract"
                android:dependency="pref_autospace" />
            <SwitchPreferenceCompat
                android:key="pref_autospace_tapped_words"
                android:title="@string/pref_autospace_tapped_words_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_autospace_tapped_words_summary"
                android:dependency="pref_autospace"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_word_ends_on_space"
                android:title="@string/pref_word_ends_on_space_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_word_ends_on_space_summary"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_double_space_period"
                android:title="@string/pref_double_space_period_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_double_space_period_summary"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_tidy_spaces"
                android:title="@string/pref_tidy_spaces_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_tidy_spaces_summary"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_spaceless_space"
                android:title="@string/pref_spaceless_space_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_spaceless_space_summary"
                android:defaultValue="false" />
        </PreferenceScreen>
        <PreferenceScreen
            android:key="pref_group_bar"
            android:title="@string/pref_group_bar_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_group_bar_summary">
            <com.kinetica.keyboard.settings.SizePreviewPreference
                android:key="pref_bar_preview"
                android:persistent="false"
                android:selectable="false" />
            <SeekBarPreference
                android:key="pref_suggestion_bar_dp"
                android:title="@string/pref_suggestion_bar_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_suggestion_bar_summary"
                android:defaultValue="44"
                android:max="72"
                app:min="24"
                app:showSeekBarValue="true" />
            <SwitchPreferenceCompat
                android:key="pref_recent_words"
                android:title="@string/pref_recent_words_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_recent_words_summary"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_badges_while_adjusting"
                android:title="@string/pref_badges_while_adjusting_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_badges_while_adjusting_summary"
                android:defaultValue="true" />
            <SwitchPreferenceCompat
                android:key="pref_retype_button"
                android:title="@string/pref_retype_button_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_retype_button_summary"
                android:defaultValue="false" />
            <!-- Beside its parent toggle on purpose: PreferenceTreeTest's
                 everyDependencyLivesWithItsParent fails at inflation if a
                 dependency crosses a screen. app:min must match
                 BarMetrics.RETYPE_MIN_DP or the slider cannot reach its floor. -->
            <SeekBarPreference
                android:key="pref_retype_button_dp"
                android:title="@string/pref_retype_button_dp_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_retype_button_dp_summary"
                android:defaultValue="34"
                android:max="72"
                app:min="24"
                app:showSeekBarValue="true"
                android:dependency="pref_retype_button" />
            <Preference
                android:key="pref_bar_actions"
                android:title="@string/pref_bar_actions_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_bar_actions_summary">
                <intent
                    android:targetPackage="@string/app_pkg"
                    android:targetClass="com.kinetica.keyboard.settings.ShortcutSetActivity">
                    <extra android:name="set" android:value="bar" />
                </intent>
            </Preference>
            <Preference
                android:key="pref_menu_actions"
                android:title="@string/pref_menu_actions_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_menu_actions_summary">
                <intent
                    android:targetPackage="@string/app_pkg"
                    android:targetClass="com.kinetica.keyboard.settings.ShortcutSetActivity">
                    <extra android:name="set" android:value="menu" />
                </intent>
            </Preference>
        </PreferenceScreen>
        <PreferenceScreen
            android:key="pref_group_learning"
            android:title="@string/pref_group_learning_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_group_learning_summary">
            <ListPreference
                android:key="pref_reinforce_increment"
                android:title="@string/pref_reinforce_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_reinforce_summary"
                android:entries="@array/reinforce_entries"
                android:entryValues="@array/reinforce_values"
                android:defaultValue="medium" />
            <SeekBarPreference
                android:key="pref_reinforce_step_dp"
                android:title="@string/pref_reinforce_step_title"
                android:summary="@string/pref_reinforce_step_summary"
                app:singleLineTitle="false"
                android:defaultValue="24"
                android:max="48"
                app:min="8"
                app:showSeekBarValue="true" />
            <SwitchPreferenceCompat
                android:key="pref_learn_phrases"
                android:title="@string/pref_learn_phrases_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_learn_phrases_summary"
                android:defaultValue="false" />
            <SwitchPreferenceCompat
                android:key="pref_retype_avoids_rejected"
                android:title="@string/pref_retype_avoids_title"
                app:singleLineTitle="false"
                android:summary="@string/pref_retype_avoids_summary"
                android:defaultValue="false" />
        </PreferenceScreen>
    </PreferenceScreen>

    <PreferenceScreen
        android:key="pref_group_look"
        android:title="@string/pref_group_look_title"
        app:singleLineTitle="false"
        android:summary="@string/pref_group_look_summary">
        <ListPreference
            android:key="pref_theme_mode"
            android:title="@string/pref_theme_mode_title"
            app:singleLineTitle="false"
            android:entries="@array/theme_mode_entries"
            android:entryValues="@array/theme_mode_values"
            android:defaultValue="default"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="pref_theme_brightness"
            android:title="@string/pref_theme_brightness_title"
            app:singleLineTitle="false"
            android:entries="@array/theme_brightness_entries"
            android:entryValues="@array/theme_brightness_values"
            android:defaultValue="dark"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="pref_theme_hue"
            android:title="@string/pref_theme_hue_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_theme_hue_summary"
            android:defaultValue="233"
            android:max="360"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
        <com.kinetica.keyboard.settings.ThemePreviewPreference
            android:key="pref_theme_preview"
            android:persistent="false"
            android:selectable="false" />
        <ListPreference
            android:key="pref_trail_color"
            android:title="@string/pref_trail_color_title"
            app:singleLineTitle="false"
            android:entries="@array/trail_color_entries"
            android:entryValues="@array/trail_color_values"
            android:defaultValue="rainbow"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="pref_trail_color_custom_hue"
            android:title="@string/pref_trail_custom_hue_title"
            app:singleLineTitle="false"
            android:defaultValue="200"
            android:max="360"
            app:min="0"
            app:showSeekBarValue="true" />
        <SwitchPreferenceCompat
            android:key="pref_zen_mode"
            android:title="@string/pref_zen_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_zen_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="pref_vibration"
            android:title="@string/pref_vibration_title"
            app:singleLineTitle="false"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="pref_vibration_intensity"
            android:title="@string/pref_vibration_intensity_title"
            app:singleLineTitle="false"
            android:defaultValue="2"
            android:max="3"
            app:min="1"
            app:showSeekBarValue="true"
            android:dependency="pref_vibration" />
    </PreferenceScreen>

    <PreferenceScreen
        android:key="pref_group_size"
        android:title="@string/pref_group_size_title"
        app:singleLineTitle="false"
        android:summary="@string/pref_group_size_summary">
        <com.kinetica.keyboard.settings.SizePreviewPreference
            android:key="pref_size_preview"
            android:persistent="false"
            android:selectable="false" />
        <SeekBarPreference
            android:key="pref_keyboard_height_pct"
            android:title="@string/pref_height_title"
