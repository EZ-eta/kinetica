            android:entryValues="@array/comma_mode_values"
            android:defaultValue="keep" />
        <EditTextPreference
            android:key="pref_comma_custom"
            android:title="@string/pref_comma_custom_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_comma_custom_summary" />
        <ListPreference
            android:key="pref_period_mode"
            android:title="@string/pref_period_mode_title"
