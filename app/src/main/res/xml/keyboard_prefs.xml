            android:defaultValue="35"
            android:max="50"
            app:min="10"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="pref_keyboard_height_pct_landscape"
            android:title="@string/pref_height_landscape_title"
            app:singleLineTitle="false"
            android:defaultValue="45"
            android:max="50"
            app:min="10"
            app:showSeekBarValue="true" />
        <ListPreference
            android:key="pref_landscape_arrangement"
            android:title="@string/pref_landscape_arrangement_title"
            app:singleLineTitle="false"
            android:entries="@array/landscape_arrangement_entries"
            android:entryValues="@array/landscape_arrangement_values"
            android:defaultValue="split"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="pref_landscape_split_gap_pct"
            android:title="@string/pref_landscape_split_gap_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_landscape_split_gap_summary"
            android:defaultValue="30"
            android:max="70"
            app:min="0"
            app:showSeekBarValue="true" />
        <ListPreference
            android:key="pref_layout_mode"
            android:title="@string/pref_layout_mode_title"
            app:singleLineTitle="false"
            android:entries="@array/layout_mode_entries"
            android:entryValues="@array/layout_mode_values"
            android:defaultValue="full"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="pref_key_arrangement"
            android:title="@string/pref_key_arrangement_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_key_arrangement_summary"
            android:entries="@array/key_arrangement_entries"
            android:entryValues="@array/key_arrangement_values"
            android:defaultValue="qwerty" />
        <SeekBarPreference
            android:key="pref_side_pad_dp"
            android:title="@string/pref_side_pad_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_side_pad_summary"
            android:defaultValue="0"
            android:max="48"
            app:min="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="pref_home_row_spread"
            android:title="@string/pref_home_row_spread_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_home_row_spread_summary"
            android:defaultValue="0"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="pref_bottom_pad_dp"
            android:title="@string/pref_bottom_pad_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_bottom_pad_summary"
            android:defaultValue="0"
            android:max="48"
            app:min="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="pref_drag_handle_dp"
            android:title="@string/pref_drag_handle_title"
            app:singleLineTitle="false"
            android:summary="@string/pref_drag_handle_summary"
            android:defaultValue="20"
            android:max="20"
            app:min="0"
            app:showSeekBarValue="true" />
