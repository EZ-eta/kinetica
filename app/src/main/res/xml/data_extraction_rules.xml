<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Everything is backed up and transferred as before but the clipboard
     history, which stays on this phone only: not in the cloud, not on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/clip_history.sealed" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/clip_history.sealed" />
    </device-transfer>
</data-extraction-rules>
