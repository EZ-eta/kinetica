<?xml version="1.0" encoding="utf-8"?>
<!--
  A long-press list's dialog: the field first, then the note with every action name in a box of
  its own that scrolls under a scrollbar that stays drawn. The dialog gives the box what height is
  left, so the field never scrolls out of sight. The ids are the ones the preference dialog binds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <EditText
        android:id="@android:id/edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:hint="@string/pref_list_field_hint"
        android:importantForAutofill="no"
        android:inputType="text|textMultiLine"
        android:minHeight="48dp" />

    <ScrollView
        android:id="@+id/list_note_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@android:id/message"
            style="?android:attr/textAppearanceSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp"
            android:textColor="?android:attr/textColorSecondary" />
    </ScrollView>
</LinearLayout>
