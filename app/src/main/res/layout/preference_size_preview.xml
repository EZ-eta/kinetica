<?xml version="1.0" encoding="utf-8"?>
<!--
  The keyboard at its configured size inside a phone outline, for the Size and keys screen.
  Replaces the whole preference row, as the theme preview's layout does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/size_preview_portrait"
        android:textSize="12sp" />

    <com.kinetica.keyboard.ui.SizePreviewView
        android:id="@+id/size_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/size_preview_landscape"
        android:textSize="12sp" />

    <com.kinetica.keyboard.ui.SizePreviewView
        android:id="@+id/size_preview_landscape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
