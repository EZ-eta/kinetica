<?xml version="1.0" encoding="utf-8"?>
<!--
  The keyboard at its configured size, for one orientation; the group above it names which.
  Replaces the whole preference row, as the theme preview's layout does.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.kinetica.keyboard.ui.SizePreviewView
        android:id="@+id/size_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</FrameLayout>
